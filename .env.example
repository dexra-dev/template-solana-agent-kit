# --- Dexra ---
# dxr_... key from https://dexra.dev/app/keys. Without it, paid checks answer 402 and every buy is blocked.
DEXRA_API_KEY=
# API base URL. Point it at a local API for testing.
DEXRA_BASE_URL=https://api.dexra.dev
# true also connects Dexra's remote MCP server; its read-only tools are added with an mcp_ prefix.
DEXRA_MCP=false
# MCP endpoint (Streamable HTTP).
DEXRA_MCP_URL=https://api.dexra.dev/mcp

# --- Trading safety ---
# Only false/0/no/off turn the dry run off. Live also needs SOLANA_PRIVATE_KEY and JUPITER_API_KEY.
DRY_RUN=true
# Hard cap per buy in SOL. A larger buy is refused, not reduced.
MAX_TRADE_SOL=0.05
# Jupiter slippage in basis points, a whole number from 0 to 1000.
SLIPPAGE_BPS=100
# true lets a "caution" verdict pass. "avoid" and "unknown" always block.
ALLOW_CAUTION=false

# --- Solana and Jupiter ---
# Base58 64-byte secret key of a dedicated wallet holding little SOL. Only read when live.
SOLANA_PRIVATE_KEY=
# Jupiter Swap API key, sent as x-api-key. Needed live; in a dry run it adds a quote.
JUPITER_API_KEY=
# RPC for Solana Agent Kit's connection.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- LLM (chat only) ---
# openai or anthropic. Defaults to anthropic when ANTHROPIC_API_KEY is set, else openai.
LLM_PROVIDER=
# Model id. Defaults: gpt-5.6-luna (openai), claude-sonnet-5-5 (anthropic).
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
